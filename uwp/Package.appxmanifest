<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  IgnorableNamespaces="uap mp">

  <Identity Name="Radokaz.CarlinhosBoy" Publisher="CN=Radokaz" Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>CarlinhosBoy</DisplayName>
    <PublisherDisplayName>Calvo Entertainment</PublisherDisplayName>
    <Logo>Assets\Cavalo50x50.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="cb.exe" EntryPoint="cb.App">
      <uap:VisualElements
        DisplayName="CarlinhosBoy"
        Description="CarlinhosBoy"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Cavalo150x150.png"
        Square44x44Logo="Assets\Cavalo44x44.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
  </Capabilities>
</Package>